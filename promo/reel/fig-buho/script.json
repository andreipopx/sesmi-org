   "id": "n1",
   "who": "narradora",
   "text": "¿Por qué un búho?",
   "t": 0
  },
  {
   "id": "n2",
   "who": "narradora",
   "text": "Hace dos mil quinientos años, Atenas acuñaba sus monedas con una lechuza.",
   "t": 0
  },
  {
   "id": "n3",
   "who": "narradora",
   "text": "El animal de Atenea, la diosa del saber. El que ve en la oscuridad.",
   "t": 0
  },
  {
   "id": "n4",
   "who": "narradora",
   "text": "Por eso nuestro búho investiga.",
   "t": 0
  },
  {
   "id": "n5",
   "who": "narradora",
   "text": "Debemos saber.",
   "t": 0
  }
 ]
}